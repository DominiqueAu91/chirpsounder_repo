--- chirpsounder_repo-main/software/ka9q-backend/radiod@chirp.conf	1970-01-01 00:00:00.000000000 +0000
+++ chirpsounder_repo-v0.3/software/ka9q-backend/radiod@chirp.conf	2026-07-02 08:42:37.399948603 +0000
@@ -0,0 +1,53 @@
+# radiod@chirp.conf
+# ka9q-radio configuration for the chirpsounder receiver
+# Hardware: RX888 MkII + GPSDO (wsprdaemon architecture), Beelink miniPC, Ubuntu 24.04 LTS
+# Derived from config/examples/radiod@rx888-wsprdaemon.conf
+#
+# Install:  sudo cp radiod@chirp.conf /etc/radio/
+#           sudo systemctl enable --now radiod@chirp
+#
+# The chirp channel itself is created and swept DYNAMICALLY by
+# phase0/chirp_tracker.py using the 'tune' utility, so no static
+# [CHIRP] section is strictly required. The section below only serves
+# as a parked prototype and for manual testing with 'control'.
+
+[global]
+hardware = rx888
+status = hf.local          # status/command multicast group (used by tune/control)
+data = hf-pcm.local        # default data group for ad-hoc sessions
+samprate = 12k             # default; the chirp channel overrides this
+mode = usb
+ttl = 0                    # keep multicast on-host (wsprdaemon practice; no IGMP-aware switch needed)
+# fft-threads = 2          # raise if the Beelink CPU allows; helps the filterbank
+# blocktime = 20           # ms; 20 ms => retune granularity and settling ~1-2 blocks
+
+[rx888]
+device = "rx888"
+description = "RX888 MkII chirpsounder - <CALLSIGN> <antenna>"
+samprate = 64m800000       # 64.8 Msps: full HF coverage, kinder to the RX888 and the CPU
+gain = 20                  # dB, AD8370 VGA; adjust so band noise raises the noise floor ~10 dB
+# calibrate = 0            # leave 0: the GPSDO disciplines the 27 MHz clock externally
+# dither = no
+# rand = no
+# att = 0                  # PE4312 attenuator if strong local BC stations
+
+# ------------------------------------------------------------------
+# NO static chirp channel section.
+# radiod creates the channel DYNAMICALLY when chirp_tracker.py sends the
+# first command via 'tune' (this requires 'data =' to be set in [global],
+# which it is above). Static sections would force SSRC = freq/1000 and
+# cannot carry a manual SSRC in current ka9q-radio.
+#
+# The tracker creates/retunes the channel with:
+#   tune -r hf.local -s 5001 -m iq -R 96k -e f32le \
+#        -L -46k -H +46k -D chirp-iq.local -f <freq>
+#
+# NOTE: the 'iq' preset defaults to low/high = +/-5 kHz, so the tracker
+# MUST override the filter edges (-L/-H) to use the full 96 kHz channel.
+# ------------------------------------------------------------------
+
+# ------------------------------------------------------------------
+# Optional: keep your WSPR channels in the same radiod instance;
+# the incremental filterbank cost of extra channels is small. Copy the
+# [WSPR] section from radiod@rx888-wsprdaemon.conf here if desired.
+# ------------------------------------------------------------------
diff -ruN chirpsounder_repo-main/software/ka9q-backend/test_dechirp_sim.py chirpsounder_repo-v0.3/software/ka9q-backend/test_dechirp_sim.py
--- chirpsounder_repo-main/software/ka9q-backend/test_dechirp_sim.py	1970-01-01 00:00:00.000000000 +0000
+++ chirpsounder_repo-v0.3/software/ka9q-backend/test_dechirp_sim.py	2026-07-02 08:43:00.755494660 +0000
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""
+test_dechirp_sim.py -- validate the stepped-LO dechirp chain offline.
+
+Simulates what radiod's IQ channel would deliver during 6 dwells while a
+100 kHz/s sounder sweeps through, with a two-path ionosphere:
+   path 1: tau = 2.0 ms (one-way virtual range ~300 km), 0 dB
+   path 2: tau = 3.4 ms (~510 km), -10 dB
+plus noise, then runs dechirp_segment() and checks the recovered delays.
+
+Added in V0.3 (ka9q-radio receiver backend).
+License: GPL-3.0-or-later
+"""
+
+import numpy as np
+from dechirp_sweep import dechirp_segment
+
+rng = np.random.default_rng(1)
+
+fs = 96e3
+rate = 100e3
+f_start = 8e6
+step = 48e3
+dwell = step / rate  # 0.48 s
+n = int(dwell * fs)
+t0 = 1000.0  # sweep start epoch (arbitrary)
+paths = [(2.0e-3, 1.0), (3.4e-3, 0.316)]
+
+segs = []
+for k in range(6):
+    fc = f_start + (k + 0.5) * step
+    t_start = t0 + k * dwell
+    t = t_start + np.arange(n) / fs
+    z = np.zeros(n, dtype=np.complex128)
+    for tau, a in paths:
+        u = t - tau - t0  # emission time since sweep start
+        frf_phase = f_start * u + 0.5 * rate * u**2  # RF phase/(2pi) at emission
+        z += a * np.exp(2j * np.pi * (frf_phase - fc * t))
+    z += (rng.normal(size=n) + 1j * rng.normal(size=n)) * 0.05
+    segs.append((z.astype(np.complex64), fc, t_start))
+
+ok = True
+for z, fc, t_start in segs:
+    f_MHz, tau_ms, S = dechirp_segment(
+        z, fs, fc, t_start, t0, rate, f_start, win_s=0.12, tau_max=6e-3
+    )
+    prof = S.mean(axis=0)
+    # find the two strongest local peaks
+    idx = np.argsort(prof)[::-1]
+    found = []
+    for i in idx:
+        if all(abs(tau_ms[i] - f) > 0.3 for f in found):
+            found.append(tau_ms[i])
+        if len(found) == 2:
+            break
+    found.sort()
+    err = [abs(found[j] - [2.0, 3.4][j]) for j in range(2)]
+    print(
+        f"dwell fc={fc/1e6:.3f} MHz  f_sound={f_MHz[0]:.3f}-{f_MHz[-1]:.3f} "
+        f"MHz  peaks at {found[0]:.3f}, {found[1]:.3f} ms  "
+        f"(err {err[0]*1e3:.1f}, {err[1]*1e3:.1f} us)"
+    )
+    ok &= max(err) < 0.05  # 50 us tolerance
+print("PASS" if ok else "FAIL")
+raise SystemExit(0 if ok else 1)
